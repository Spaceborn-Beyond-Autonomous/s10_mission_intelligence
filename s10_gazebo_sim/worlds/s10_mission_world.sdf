<?xml version="1.0" ?>
<!--
  S10 Mission Intelligence — Gazebo Sim World
  ============================================
  A 200 × 200 m arena with:
    • Ground plane + sun
    • 6 obstacle buildings of varying size
    • 3 translucent red "risk zones" (geofences)
    • 8 numbered waypoint posts arranged in a mission loop
    • A landing pad at the origin
-->
<sdf version="1.9">
  <world name="s10_mission_world">

    <!-- ─── Physics ─────────────────────────────────────────────────── -->
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ─── Plugins ─────────────────────────────────────────────────── -->
    <plugin filename="gz-sim-physics-system"      name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system"       name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"           name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system"       name="gz::sim::systems::Contact"/>

    <!-- ─── Sun ─────────────────────────────────────────────────────── -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.95 0.92 0.85 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ─── Ground Plane ────────────────────────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.35 0.45 0.30 1</ambient>
            <diffuse>0.35 0.45 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ─── Landing Pad (origin) ────────────────────────────────────── -->
    <model name="landing_pad">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>1.5</radius><length>0.02</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.9 0.0 1</ambient>
            <diffuse>0.9 0.9 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════
         OBSTACLE BUILDINGS
         ═══════════════════════════════════════════════════════════════ -->
    <model name="building_1">
      <static>true</static>
      <pose>20 15 5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>6 6 10</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>6 6 10</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="building_2">
      <static>true</static>
      <pose>-25 30 7.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>8 4 15</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>8 4 15</size></box></geometry>
          <material><ambient>0.50 0.40 0.35 1</ambient><diffuse>0.50 0.40 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="building_3">
      <static>true</static>
      <pose>35 -20 4 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>5 10 8</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>5 10 8</size></box></geometry>
          <material><ambient>0.45 0.50 0.60 1</ambient><diffuse>0.45 0.50 0.60 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="building_4">
      <static>true</static>
      <pose>-15 -35 6 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>7 7 12</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>7 7 12</size></box></geometry>
          <material><ambient>0.60 0.55 0.50 1</ambient><diffuse>0.60 0.55 0.50 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="building_5">
      <static>true</static>
      <pose>50 50 3.5 0 0 0.4</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>4 12 7</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>4 12 7</size></box></geometry>
          <material><ambient>0.40 0.45 0.50 1</ambient><diffuse>0.40 0.45 0.50 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="building_6">
      <static>true</static>
      <pose>-50 -10 5 0 0 -0.3</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10 5 10</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>10 5 10</size></box></geometry>
          <material><ambient>0.50 0.48 0.45 1</ambient><diffuse>0.50 0.48 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════
         RISK ZONES  (translucent red cylinders)
         ═══════════════════════════════════════════════════════════════ -->
    <model name="risk_zone_1">
      <static>true</static>
      <pose>30 30 0.05 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>15</radius><length>0.1</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.15 0.1 0.30</ambient>
            <diffuse>0.9 0.15 0.1 0.30</diffuse>
          </material>
          <transparency>0.7</transparency>
        </visual>
      </link>
    </model>

    <model name="risk_zone_2">
      <static>true</static>
      <pose>-30 -25 0.05 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>12</radius><length>0.1</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.15 0.1 0.30</ambient>
            <diffuse>0.9 0.15 0.1 0.30</diffuse>
          </material>
          <transparency>0.7</transparency>
        </visual>
      </link>
    </model>

    <model name="risk_zone_3">
      <static>true</static>
      <pose>-40 40 0.05 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>10</radius><length>0.1</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.6 0.1 0.30</ambient>
            <diffuse>0.9 0.6 0.1 0.30</diffuse>
          </material>
          <transparency>0.7</transparency>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════
         WAYPOINT POSTS  (thin green cylinders with sphere tops)
         ═══════════════════════════════════════════════════════════════ -->
    <model name="wp1"><static>true</static><pose>10 10 1 0 0 0</pose>
      <link name="link">
        <visual name="pole"><geometry><cylinder><radius>0.15</radius><length>2</length></cylinder></geometry>
          <material><ambient>0.1 0.7 0.2 1</ambient><diffuse>0.1 0.7 0.2 1</diffuse></material></visual>
        <visual name="top"><pose>0 0 1.2 0 0 0</pose><geometry><sphere><radius>0.35</radius></sphere></geometry>
          <material><ambient>0.1 0.9 0.3 1</ambient><diffuse>0.1 0.9 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wp2"><static>true</static><pose>40 10 1 0 0 0</pose>
      <link name="link">
        <visual name="pole"><geometry><cylinder><radius>0.15</radius><length>2</length></cylinder></geometry>
          <material><ambient>0.1 0.7 0.2 1</ambient><diffuse>0.1 0.7 0.2 1</diffuse></material></visual>
        <visual name="top"><pose>0 0 1.2 0 0 0</pose><geometry><sphere><radius>0.35</radius></sphere></geometry>
          <material><ambient>0.1 0.9 0.3 1</ambient><diffuse>0.1 0.9 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wp3"><static>true</static><pose>50 40 1 0 0 0</pose>
      <link name="link">
        <visual name="pole"><geometry><cylinder><radius>0.15</radius><length>2</length></cylinder></geometry>
          <material><ambient>0.1 0.7 0.2 1</ambient><diffuse>0.1 0.7 0.2 1</diffuse></material></visual>
        <visual name="top"><pose>0 0 1.2 0 0 0</pose><geometry><sphere><radius>0.35</radius></sphere></geometry>
          <material><ambient>0.1 0.9 0.3 1</ambient><diffuse>0.1 0.9 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wp4"><static>true</static><pose>20 60 1 0 0 0</pose>
      <link name="link">
        <visual name="pole"><geometry><cylinder><radius>0.15</radius><length>2</length></cylinder></geometry>
          <material><ambient>0.1 0.7 0.2 1</ambient><diffuse>0.1 0.7 0.2 1</diffuse></material></visual>
        <visual name="top"><pose>0 0 1.2 0 0 0</pose><geometry><sphere><radius>0.35</radius></sphere></geometry>
          <material><ambient>0.1 0.9 0.3 1</ambient><diffuse>0.1 0.9 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wp5"><static>true</static><pose>-20 50 1 0 0 0</pose>
      <link name="link">
        <visual name="pole"><geometry><cylinder><radius>0.15</radius><length>2</length></cylinder></geometry>
          <material><ambient>0.1 0.7 0.2 1</ambient><diffuse>0.1 0.7 0.2 1</diffuse></material></visual>
        <visual name="top"><pose>0 0 1.2 0 0 0</pose><geometry><sphere><radius>0.35</radius></sphere></geometry>
          <material><ambient>0.1 0.9 0.3 1</ambient><diffuse>0.1 0.9 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wp6"><static>true</static><pose>-40 20 1 0 0 0</pose>
      <link name="link">
        <visual name="pole"><geometry><cylinder><radius>0.15</radius><length>2</length></cylinder></geometry>
          <material><ambient>0.1 0.7 0.2 1</ambient><diffuse>0.1 0.7 0.2 1</diffuse></material></visual>
        <visual name="top"><pose>0 0 1.2 0 0 0</pose><geometry><sphere><radius>0.35</radius></sphere></geometry>
          <material><ambient>0.1 0.9 0.3 1</ambient><diffuse>0.1 0.9 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wp7"><static>true</static><pose>-30 -10 1 0 0 0</pose>
      <link name="link">
        <visual name="pole"><geometry><cylinder><radius>0.15</radius><length>2</length></cylinder></geometry>
          <material><ambient>0.1 0.7 0.2 1</ambient><diffuse>0.1 0.7 0.2 1</diffuse></material></visual>
        <visual name="top"><pose>0 0 1.2 0 0 0</pose><geometry><sphere><radius>0.35</radius></sphere></geometry>
          <material><ambient>0.1 0.9 0.3 1</ambient><diffuse>0.1 0.9 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wp8"><static>true</static><pose>-10 -30 1 0 0 0</pose>
      <link name="link">
        <visual name="pole"><geometry><cylinder><radius>0.15</radius><length>2</length></cylinder></geometry>
          <material><ambient>0.1 0.7 0.2 1</ambient><diffuse>0.1 0.7 0.2 1</diffuse></material></visual>
        <visual name="top"><pose>0 0 1.2 0 0 0</pose><geometry><sphere><radius>0.35</radius></sphere></geometry>
          <material><ambient>0.1 0.9 0.3 1</ambient><diffuse>0.1 0.9 0.3 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
